{
  "name": "@beavent/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Browser end-to-end tests against a running stack (API + apps). Not part of `npm test`; run with `npm run e2e`.",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "visual": "playwright test -c visual.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "typescript": "^7",
    "@beavent/config": "*"
  }
}
