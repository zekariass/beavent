# Copy to .env (never commit .env). Values below match docker-compose.yml for local development.
# In staging/production, these come from the secret manager; the database stores only *_secret_ref values.

# --- Backend (backend/src/main/resources/application.properties reads these)
DATABASE_URL=jdbc:postgresql://localhost:5433/beavent
DATABASE_USER=beavent
DATABASE_PASSWORD=beavent
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=beavent
RABBITMQ_PASSWORD=beavent

# --- Object storage (MinIO locally; any S3-compatible service later)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=beavent
S3_SECRET_KEY=beavent-dev-secret
S3_BUCKET_PUBLIC=beavent-public
S3_BUCKET_PRIVATE=beavent-private

# --- Email (Mailpit catches everything: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Chapa (Stage 3). Locally this points at the stub; test/live keys come from the Chapa dashboard.
CHAPA_BASE_URL=http://localhost:8090
CHAPA_SECRET_KEY=CHASECK_TEST-beavent-stub
CHAPA_WEBHOOK_SECRET=beavent-stub-webhook-secret

# --- SMS gateway (Stage 0, step 0.7; provider to be chosen — plan dependency D4)
SMS_PROVIDER=log
SMS_API_KEY=

# --- Web apps
NEXT_PUBLIC_API_URL=http://localhost:8080
