# Copy to .env (never commit .env). Values below match docker-compose.yml for local development.
# In staging/production, these come from the secret manager; the database stores only *_secret_ref values.

# --- Backend (services/backend/src/main/resources/application.properties reads these; `./gradlew bootRun` uses the
# "local" profile, which already contains these local values — set them explicitly outside local development)
# Schema owner: Flyway migrations only.
DATABASE_URL=jdbc:postgresql://localhost:5433/beavent
DATABASE_USER=beavent
DATABASE_PASSWORD=beavent
# Least-privilege role logins used at runtime (docs/05 §5). Locally created by db/local/afterMigrate__local_login_roles.sql.
DB_APP_USER=beavent_app_login
DB_APP_PASSWORD=beavent_app
DB_IDENTITY_USER=beavent_identity_login
DB_IDENTITY_PASSWORD=beavent_identity
DB_SYSTEM_USER=beavent_system_login
DB_SYSTEM_PASSWORD=beavent_system
OUTBOX_RELAY_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=beavent
RABBITMQ_PASSWORD=beavent

# --- Object storage (SeaweedFS locally; any S3-compatible service, e.g. Cloudflare R2 or AWS S3, later)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=beavent
S3_SECRET_KEY=beavent-dev-secret
S3_BUCKET_PUBLIC=beavent-public
S3_BUCKET_PRIVATE=beavent-private
FILES_PUBLIC_BASE_URL=http://localhost:8333/beavent-public
# Malware scanner: "eicar" locally (test signature only); "clamav" with CLAMAV_HOST/CLAMAV_PORT in production.
FILE_SCANNER=eicar

# --- Email (Mailpit catches everything: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Chapa (Stage 3). Locally this points at the stub; test/live keys come from the Chapa dashboard.
CHAPA_BASE_URL=http://localhost:8090
CHAPA_SECRET_KEY=CHASECK_TEST-beavent-stub
CHAPA_WEBHOOK_SECRET=beavent-stub-webhook-secret

# --- Identity (step 0.7). The "local" profile has its own development values; outside it these are required.
# AUTH_SECRET_KEY: base64, at least 32 random bytes (e.g. `openssl rand -base64 32`).
AUTH_SECRET_KEY=
# Private EC P-256 signing key as a JWK with a kid. Empty locally: the local profile creates a throwaway key.
AUTH_JWT_SIGNING_JWK=
# Comma-separated OAuth client ids; provider sign-in stays disabled while empty.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- SMS gateway for one-time codes (provider to be chosen — plan dependency D4). "log" writes codes to the log.
SMS_PROVIDER=log
SMS_API_KEY=

# --- Email (invitations now; templated notifications in Stage 8). "log" writes emails to the log.
EMAIL_PROVIDER=log

# --- Tenancy: base URL of the business console (web platform, /business) used in invitation links
PARTNER_PORTAL_URL=http://localhost:3000/business

# --- Web platform: secret URL prefix of the admin console (letters, digits, - and _). Required in production —
# without it the console is off. Locally it defaults to /ops. Keep it out of the repository and out of robots.txt.
ADMIN_PATH=ops

# --- Web apps
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side API URL for the Next.js apps (the admin console calls the API only from its server).
BEAVENT_API_URL=http://localhost:8080

# Origins allowed to call the API from a browser (comma-separated), e.g. the Expo web build.
WEB_ALLOWED_ORIGINS=http://localhost:8081
