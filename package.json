{
  "name": "beavent",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "mobile",
    "web",
    "business",
    "admin-console",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "cd backend && ./gradlew build",
    "db:up": "docker compose up -d",
    "db:validate": "db/scripts/validate.sh --docker",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
