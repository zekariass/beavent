{
  "name": "beavent",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "mobile",
    "web",
    "business",
    "admin-console",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "cd backend && ./gradlew build",
    "db:up": "docker compose up -d",
    "db:validate": "db/scripts/validate.sh --docker",
    "test": "turbo run test",
    "api:lint": "redocly lint beavent",
    "api:bundle": "redocly bundle beavent -o packages/api-client/openapi.yaml",
    "api:types": "openapi-typescript",
    "api:spec": "npm run api:lint && npm run api:bundle && npm run api:types"
  },
  "devDependencies": {
    "@redocly/cli": "^2.79.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
