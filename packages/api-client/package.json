{
  "name": "@beavent/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Beavent API, generated from services/backend/src/main/openapi (npm run api:spec).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@beavent/config": "*",
    "@types/node": "^26.6.6",
    "typescript": "^7"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.3",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4"
  },
  "files": [
    "src",
    "openapi.yaml"
  ]
}
